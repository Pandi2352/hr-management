# ==============================================================================
# PeopleOS — Global Environment Variables Template
# Copy this file to .env before starting services
# ==============================================================================

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ------------------------------------------------------------------------------
# MongoDB Connection (Replica Set enabled for ACID multi-document transactions)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://admin:password123@localhost:27017/peopleos?authSource=admin&replicaSet=rs0
MONGODB_DATABASE=peopleos

# ------------------------------------------------------------------------------
# Redis Cache & BullMQ Queue
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_characters_long_12345
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_characters_long_12345
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Default Super Admin Seed Credentials (for initial development setup)
# ------------------------------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL=admin@peopleos.internal
SEED_SUPER_ADMIN_PASSWORD=Admin@12345
SEED_SUPER_ADMIN_FIRSTNAME=System
SEED_SUPER_ADMIN_LASTNAME=Administrator

# ------------------------------------------------------------------------------
# Frontend Client URL & CORS Configuration
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=*
VITE_API_BASE_URL=http://localhost:3000/api/v1
